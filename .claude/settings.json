{
  "permissions": {
    "allow": [
      "Bash(py -m pytest *)",
      "Bash(py -m ruff check *)",
      "Bash(py -m black *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git merge --no-ff *)",
      "Bash(git push *)"
    ]
  },
  "env": {
    "ENABLE_CODE_SECURITY_REVIEW": "0",
    "ENABLE_STOP_REVIEW": "0",
    "ENABLE_COMMIT_REVIEW": "0"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "data@synced": true,
    "engineering@synced": true,
    "security-guidance@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "example-skills@anthropic-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "py \"${CLAUDE_PROJECT_DIR:-.}/tools/skill_audit.py\" hook 2>/dev/null || python3 \"${CLAUDE_PROJECT_DIR:-.}/tools/skill_audit.py\" hook 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "py \"${CLAUDE_PROJECT_DIR:-.}/tools/skill_audit.py\" hook 2>/dev/null || python3 \"${CLAUDE_PROJECT_DIR:-.}/tools/skill_audit.py\" hook 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
