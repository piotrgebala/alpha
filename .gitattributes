# Rejestr uzycia skilli (CLAUDE.md, zasada 19): plik na galaz; union na wypadek dwoch sesji na jednej galezi.
runs/skille/*.jsonl merge=union text eol=lf
# Skrypty bash muszą mieć końce linii LF także w kopii roboczej na Windows (Git Bash, serwer Linux)
*.sh text eol=lf
# Pliki wsadowe Windows: CRLF w każdym klonie (cmd źle czyta etykiety przy LF)
*.bat text eol=crlf
# Log przebiegów dziennika: dopisywany na końcu przez różne maszyny — przy scalaniu zachowaj oba wpisy
dziennik/przebiegi.log merge=union
